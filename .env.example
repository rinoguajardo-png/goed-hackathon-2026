# Copy to .env.local and fill in values. Never commit .env.local.

# --- LLM Provider ---
# Which provider to use: "mock" | "anthropic" | "openai" | "gemini"
LLM_PROVIDER=mock

# Set whichever key(s) correspond to LLM_PROVIDER. Leave blank to use the mock provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Government Data Sources ---
# Grants.gov Search2 API is public and currently requires no key.
# https://api.grants.gov/v1/api/search2
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api/search2

# SAM.gov (future use — opportunities/entity data require a free API key)
SAM_GOV_API_KEY=

# USAspending.gov API is public and requires no key.
# https://api.usaspending.gov

# --- Persistence (optional today; wire up only where it adds value) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
